# Backend API configuration.
#
# The tool pages in app/tools/** call the R/Plumber statistical backends
# directly from the browser, so these must be NEXT_PUBLIC_-prefixed for
# Next.js to inline them into the client bundle (see app/lib/apiConfig.ts).
#
# Copy this file to `.env.local` and adjust if your backend lives somewhere
# other than the local-development defaults. `.env.local` is gitignored and
# never committed - it's the right place for machine-specific or
# deployment-specific values. If you omit a variable entirely, the app
# falls back to the local-development default shown below, so a fresh
# checkout works with zero configuration.
#
# Do not put secrets here - these are backend base URLs only, and because
# they are NEXT_PUBLIC_*, whatever you put here is visible in the browser's
# compiled JavaScript. Never commit a private/internal deployment URL you
# don't want publicly known.

# api.R - Forest Plot / Funnel Plot / Sensitivity (LOO) / Bias / GRADE
NEXT_PUBLIC_META_API_URL=http://127.0.0.1:8000

# tsa-api.R - Trial Sequential Analysis
NEXT_PUBLIC_TSA_API_URL=http://127.0.0.1:8001

# nma-api.R - Network Meta-Analysis
NEXT_PUBLIC_NMA_API_URL=http://127.0.0.1:8002

# metareg-api.R - Pairwise Meta-Regression
NEXT_PUBLIC_META_REGRESSION_API_URL=http://127.0.0.1:8003

# rob-api.R - AI-Assisted Risk of Bias Assessment traffic-light/summary plots
NEXT_PUBLIC_ROB_API_URL=http://127.0.0.1:8004

# km-digitizer-api.R - Kaplan-Meier Curve Digitizer survival data
# reconstruction (Guyot et al. 2012 method, via the IPDfromKM R package).
# No AI/LLM involved - this is deterministic statistical computation only.
NEXT_PUBLIC_KM_DIGITIZER_API_URL=http://127.0.0.1:8005

# --- Gemini AI features (server-side only) ---
# Shared by two tools: AI-Assisted Risk of Bias Assessment
# (app/api/rob/assess/route.ts) and Meta-Analysis Data Extraction
# (app/api/extraction/process-study/route.ts) - both go through the same
# app/lib/ai/GeminiProvider.ts.
#
# GEMINI_API_KEY is read ONLY server-side and must NEVER be prefixed with NEXT_PUBLIC_
# - doing so would ship it to every visitor's browser. Get a free key from
# https://aistudio.google.com/apikey and put it in your own .env.local
# (gitignored, never commit it).
GEMINI_API_KEY=
# Optional - defaults to gemini-3.6-flash if omitted (verified as the
# current supported model as of this writing - Google periodically
# deprecates older model names, so change this if you hit a 404 "model no
# longer available" error). Change this to point at a newer/different model
# without touching any source file.
GEMINI_MODEL=gemini-3.6-flash

# --- Tool access control (locked tools / request-access / admin approval) ---
# Supabase project: free tier, no credit card. Create at supabase.com, then
# Project Settings -> API for these two values. Run supabase/schema.sql
# once in the SQL Editor to create the tool_access table.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key (Project Settings -> API -> service_role, "secret").
# SERVER-ONLY - never prefix with NEXT_PUBLIC_. Used only by API routes to
# create/approve/deny access requests (bypasses Row Level Security, which
# is exactly why it must never reach the browser).
SUPABASE_SERVICE_ROLE_KEY=

# Resend: free tier (3,000 emails/month), no credit card. Create at
# resend.com -> API Keys. Used to notify the two admin emails
# (see app/lib/access/toolRegistry.ts) when someone requests access, and to
# notify the requester when a decision is made.
RESEND_API_KEY=
# Optional - defaults to Resend's own shared test sender, which works
# immediately with no setup but looks less official. Verify your own
# domain in the Resend dashboard, then set this to an address at it (e.g.
# "MetaWorld Research Academy <access@yourdomain.com>") for a real sender.
RESEND_FROM_EMAIL=

# Used to build correct links in notification emails and the admin panel.
# Falls back to the current Vercel URL if omitted.
NEXT_PUBLIC_SITE_URL=https://metaworld-academy.vercel.app
